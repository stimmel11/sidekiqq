# =====================================================================
# SideKiqq Brain — environment variables
# Copy to .env.local for local dev; set the same keys in Vercel → Settings → Environment Variables.
# REQUIRED = the brain will not serve that feature without it.
# =====================================================================

# --- Claude ----------------------------------------------------------
# REQUIRED. Anthropic API key used by /api/ask, /api/cron/scan, /api/brief, /api/top5.
ANTHROPIC_API_KEY=
# Model id. Default: claude-sonnet-5-5
CLAUDE_MODEL=claude-sonnet-5-5
# Max output tokens per model call. Default: 2048
CLAUDE_MAX_TOKENS=2048
# Max model round-trips per /api/ask before the final `respond` tool is forced. Default: 8
ASK_MAX_TOOL_ITERATIONS=8
# Optional override for the system prompt file. Default: <project>/prompts/operating-system.md
# SYSTEM_PROMPT_PATH=

# --- Owner -----------------------------------------------------------
# REQUIRED. >=16 chars. Protects /api/devices/pair-code and /api/google/connect.
# Generate: openssl rand -base64 32
OWNER_SECRET=
# REQUIRED for the owner web dashboard (/dashboard). >=32 chars. HMAC key for the signed,
# httpOnly session cookie set after you sign in with OWNER_SECRET (7-day sessions).
# Rotating it signs out every browser. Generate: openssl rand -base64 48
SESSION_SECRET=
# Name the assistant uses for the owner in prompts and "who" fields. Default: Stimmel
OWNER_NAME=Stimmel
# IANA time zone for "today", briefs and inferred dates. Default: America/Denver
OWNER_TIMEZONE=America/Denver
# Pairing code lifetime in seconds. Default: 600
PAIR_CODE_TTL_SECONDS=600

# --- Upstash Redis ---------------------------------------------------
# REQUIRED. From the Upstash console (REST API section). The Vercel Upstash integration's
# KV_REST_API_URL / KV_REST_API_TOKEN are also accepted.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Key namespace (lets several environments share one database). Default: sk
REDIS_PREFIX=sk
# Conversation history TTL (seconds, slides on every turn) and max stored turns. Defaults: 21600 / 24
CONVERSATION_TTL_SECONDS=21600
CONVERSATION_MAX_MESSAGES=24

# --- Google OAuth (Gmail, Calendar, Drive) ---------------------------
# REQUIRED. OAuth 2.0 Client ID of type "Web application" in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" on the OAuth client.
# Default: ${APP_URL}/api/google/callback
GOOGLE_REDIRECT_URI=
# Optional: refuse to connect any Google account other than this one.
GOOGLE_ALLOWED_EMAIL=
# REQUIRED. 32-byte key (base64 or 64 hex chars) for AES-256-GCM encryption of the Google
# refresh token at rest. Generate: openssl rand -base64 32
# Rotating it invalidates the stored token (owner must reconnect).
TOKEN_ENCRYPTION_KEY=

# Public base URL of this deployment (used to build the OAuth redirect URI).
# Default on Vercel: https://$VERCEL_PROJECT_PRODUCTION_URL ; locally http://localhost:3000
APP_URL=

# --- Cron -------------------------------------------------------------
# REQUIRED for /api/cron/scan. Vercel Cron sends "Authorization: Bearer $CRON_SECRET" automatically.
# Generate: openssl rand -base64 32
CRON_SECRET=
# Max Gmail messages analysed per scan run. Default: 20
SCAN_MAX_MESSAGES=20
# How far back the very first scan looks (hours). Default: 24
SCAN_LOOKBACK_HOURS=24

# --- Speech-to-text (/api/transcribe) ---------------------------------
# "openai-whisper" (default) or "deepgram"
TRANSCRIBE_PROVIDER=openai-whisper
# Language hint. Default: en
TRANSCRIBE_LANGUAGE=en
# Comma-separated names/terms to bias recognition. Default: SideKiqq,Stimmel
TRANSCRIBE_VOCABULARY=SideKiqq,Stimmel
# For openai-whisper:
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1
# Any OpenAI-compatible transcription endpoint. Default: https://api.openai.com/v1
OPENAI_BASE_URL=
# For deepgram:
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# --- Push notifications (FCM) ----------------------------------------
# Firebase service-account JSON (raw JSON or base64 of it). If unset, pushes are logged, not sent.
# Firebase console → Project settings → Service accounts → Generate new private key.
FIREBASE_SERVICE_ACCOUNT_JSON=
