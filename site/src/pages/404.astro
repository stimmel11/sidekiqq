---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page doesn't exist." noindex>
  <section class="wrap py-24 md:py-32">
    <p class="data text-muted">404</p>
    <h1 class="mt-3 text-[2.5rem] font-semibold sm:text-[3.4rem]">This page doesn't exist.</h1>
    <p class="mt-5 max-w-xl text-lg text-muted">The link may be old, or the address mistyped. Nothing you were waiting on is lost.</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/" class="btn btn-primary">Go to the home page</a>
      <a href="/blog" class="btn btn-quiet">Read the blog</a>
    </div>
  </section>
</Base>
