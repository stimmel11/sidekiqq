---
/** Every file in src/content/pages/ becomes a page at /<file-name>. */
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Waitlist from '../components/Waitlist.astro';
import DeviceDetail from '../components/DeviceDetail.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
}
interface Props { page: CollectionEntry<'pages'> }
const { page } = Astro.props;
const { Content } = await render(page);
const devices = page.data.template === 'devices'
  ? (await getCollection('devices')).sort((a, b) => a.data.order - b.data.order)
  : [];
---
<Base title={page.data.title} description={page.data.description}>
  <header class="wrap pt-14 pb-10 md:pt-20">
    <h1 class="text-[2.5rem] font-semibold sm:text-[3.4rem]">{page.data.title}</h1>
    <p class="mt-5 max-w-2xl text-lg text-muted sm:text-xl">{page.data.intro}</p>
  </header>
  {devices.length > 0 && (
    <div class="wrap">
      <ul class="border-t border-line">{devices.map((d) => <DeviceDetail device={d} />)}</ul>
    </div>
  )}
  <div class="wrap py-10"><div class="prose"><Content /></div></div>
  {page.data.showWaitlist && <Waitlist />}
</Base>
