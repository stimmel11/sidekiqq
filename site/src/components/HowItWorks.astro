---
/** "How it works" — a step-by-step log. Steps come from home.md → howItWorks.steps. */
import type { CollectionEntry } from 'astro:content';
interface Props { data: CollectionEntry<'home'>['data']['howItWorks'] }
const { data } = Astro.props;
const last = data.steps.length - 1;
---
<section id="how-it-works" class="wrap scroll-mt-8 py-16 sm:py-20 lg:py-28">
  <div class="max-w-2xl">
    <h2 class="text-3xl font-semibold sm:text-[2.6rem]">{data.heading}</h2>
    <p class="mt-4 text-lg text-muted">{data.intro}</p>
  </div>
  <ol class="mt-12 border-t border-line">
    {data.steps.map((step, i) => (
      <li class:list={['step grid gap-x-8 gap-y-2 border-b border-line py-6 md:grid-cols-[3rem_1fr_1.3fr_14rem] md:items-baseline', i === last && 'is-yours']}>
        <span class="data text-muted" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="text-xl font-semibold">{step.title}</h3>
        <p class="text-muted">{step.body}</p>
        <p class="data mt-2 whitespace-pre-line rounded-md border border-line bg-surface px-3 py-2 leading-relaxed md:mt-0">{step.sample}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .step.is-yours { position: relative; }
  .step.is-yours::before {
    content: ''; position: absolute; left: 0; right: 0; top: -1px; height: 2px; background: var(--accent);
  }
  .step.is-yours h3::after {
    content: 'You'; margin-left: .6rem; vertical-align: middle;
    font: 500 .75rem/1 var(--font-data); padding: .25rem .45rem; border-radius: 999px;
    background: var(--accent); color: var(--on-accent);
  }
</style>
