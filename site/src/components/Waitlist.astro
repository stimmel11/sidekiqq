---
/**
 * Waitlist box. Copy and provider live in src/content/site.json → waitlist.
 * - provider "form" + PUBLIC_WAITLIST_ENDPOINT set → a plain HTML form POST to that URL
 *   (enhanced with fetch so the visitor stays on the page when the provider allows it).
 * - otherwise → a mailto link to waitlist.fallbackEmail.
 */
import { site, waitlistMode } from '../lib/site';
const w = site.waitlist;
---
<section id="waitlist" class="wrap scroll-mt-8 py-16 sm:py-20 lg:py-28">
  <div class="grid gap-10 rounded-2xl border border-line bg-surface p-6 sm:p-10 lg:grid-cols-[1fr_1.1fr] lg:items-center lg:p-14">
    <div>
      <h2 class="text-3xl font-semibold sm:text-[2.6rem]">{w.heading}</h2>
      <p class="mt-4 max-w-md text-lg text-muted">{w.body}</p>
    </div>
    {waitlistMode.kind === 'form' ? (
      <form action={waitlistMode.endpoint} method="post" data-waitlist class="w-full">
        <label for="waitlist-email" class="block font-medium">{w.inputLabel}</label>
        <div class="mt-2 flex flex-col gap-3 sm:flex-row">
          <input id="waitlist-email" name={w.fieldName} type="email" required autocomplete="email" placeholder={w.placeholder}
            class="min-h-12 w-full flex-1 rounded-md border border-line bg-bg px-4 text-base text-fg placeholder:text-muted focus:border-accent focus:outline-none focus-visible:outline-2" />
          <button type="submit" class="btn btn-primary min-h-12">{w.buttonLabel}</button>
        </div>
        <p data-status role="status" aria-live="polite" class="mt-3 min-h-6 text-[.95rem]"></p>
        <template data-ok>{w.successMessage}</template>
        <template data-err>{w.errorMessage}</template>
      </form>
    ) : (
      <div>
        <p class="text-muted">{w.fallbackBody}</p>
        <a href={waitlistMode.href} class="btn btn-primary mt-5">{w.fallbackButtonLabel}</a>
      </div>
    )}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-waitlist]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const msg = (sel: string) => form.querySelector<HTMLTemplateElement>(sel)?.innerHTML ?? '';
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const button = form.querySelector('button')!;
      button.disabled = true;
      status.className = 'mt-3 min-h-6 text-[.95rem] text-muted';
      status.textContent = 'Sending…';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        status.className = 'mt-3 min-h-6 text-[.95rem] text-steady-text';
        status.textContent = msg('[data-ok]');
      } catch (err) {
        // The provider blocks cross-site fetch (CORS): fall back to a normal form POST.
        if (err instanceof TypeError) { form.submit(); return; }
        status.className = 'mt-3 min-h-6 text-[.95rem] text-alert';
        status.textContent = msg('[data-err]');
      } finally {
        button.disabled = false;
      }
    });
  });
</script>
