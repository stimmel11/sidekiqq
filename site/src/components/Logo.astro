---
/** The SideKiqq wordmark: name in Space Grotesk with a Signal "status light". */
import { site } from '../lib/site';
---
<span class="inline-flex items-center gap-2 font-heading font-bold text-[1.2rem] tracking-[-0.03em]">
  <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" class="shrink-0">
    <circle cx="7" cy="7" r="6" fill="none" stroke="currentColor" stroke-width="1.5" />
    <circle cx="7" cy="7" r="2.6" fill="var(--accent)" />
  </svg>
  {site.name}
</span>
