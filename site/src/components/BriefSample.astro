---
/** Sample Daily Brief. Content: home.md → brief. Keep every name fictional. */
import type { CollectionEntry } from 'astro:content';
interface Props { data: CollectionEntry<'home'>['data']['brief'] }
const { data } = Astro.props;
const b = data.sample;
const tone: Record<string, string> = {
  CRITICAL: 'text-alert', HIGH: 'text-alert', MEDIUM: 'text-fg', LOW: 'text-muted', FYI: 'text-muted',
};
---
<section class="wrap grid gap-12 py-20 lg:grid-cols-[1fr_1.5fr] lg:gap-16 lg:py-28">
  <div class="lg:sticky lg:top-10 lg:self-start">
    <h2 class="text-3xl font-semibold sm:text-[2.6rem]">{data.heading}</h2>
    <p class="mt-4 text-lg text-muted">{data.intro}</p>
    <p class="mt-6 text-sm text-muted">{data.disclaimer}</p>
  </div>
  <article class="rounded-xl border border-line bg-surface" aria-label="Sample daily brief">
    <header class="flex items-baseline justify-between gap-4 border-b border-line px-5 py-4 sm:px-7">
      <h3 class="font-heading text-lg font-semibold">Daily brief</h3>
      <p class="data text-muted">{b.date}</p>
    </header>
    <div class="grid gap-x-8 gap-y-6 px-5 py-6 sm:grid-cols-2 sm:px-7">
      {b.sections.map((s) => (
        <div>
          <h4 class="font-heading text-sm font-semibold text-muted">{s.title}</h4>
          <ul class="mt-2 space-y-1.5 text-[.95rem]">{s.items.map((i) => <li>{i}</li>)}</ul>
        </div>
      ))}
    </div>
    <div class="border-t border-line px-5 py-6 sm:px-7">
      <h4 class="font-heading text-sm font-semibold text-muted">Top 5 today</h4>
      <ol class="mt-3 divide-y divide-line">
        {b.top5.map((t, i) => (
          <li class="grid grid-cols-[1.5rem_1fr] gap-x-3 py-3 sm:grid-cols-[1.5rem_1fr_5rem]">
            <span class="data pt-0.5 text-muted">{i + 1}</span>
            <div>
              <p class="font-medium">{t.title}</p>
              <p class="text-sm text-muted">{t.why}</p>
            </div>
            <span class:list={['data col-start-2 pt-1 sm:col-start-3 sm:pt-0.5 sm:text-right', tone[t.importance]]}>{t.importance}</span>
          </li>
        ))}
      </ol>
    </div>
  </article>
</section>
