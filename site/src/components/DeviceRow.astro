---
/** Compact list of all devices for the home page. Data: src/content/devices/*.md */
import { getCollection } from 'astro:content';
import DeviceArt from './DeviceArt.astro';
import StatusTag from './StatusTag.astro';
import type { CollectionEntry } from 'astro:content';
interface Props { data: CollectionEntry<'home'>['data']['devices'] }
const { data } = Astro.props;
const devices = (await getCollection('devices')).sort((a, b) => a.data.order - b.data.order);
---
<section class="wrap py-16 sm:py-20 lg:py-28">
  <div class="flex flex-wrap items-end justify-between gap-6">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-semibold sm:text-[2.6rem]">{data.heading}</h2>
      <p class="mt-4 text-lg text-muted">{data.intro}</p>
    </div>
    <a href={data.link.href} class="btn btn-quiet">{data.link.label}</a>
  </div>
  <ul class="mt-12 grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-line bg-line lg:grid-cols-5 [&>li:last-child]:col-span-2 lg:[&>li:last-child]:col-span-1">
    {devices.map((d) => (
      <li class="flex flex-col bg-bg p-5">
        <DeviceArt art={d.data.art} class="mx-auto h-24 w-24 sm:h-28 sm:w-28" />
        <h3 class="mt-4 text-lg font-semibold">{d.data.name}</h3>
        <p class="text-sm text-muted">{d.data.role}</p>
        <p class="mt-2 text-[.95rem]">{d.data.summary}</p>
        {d.data.status !== 'In development' && <StatusTag status={d.data.status} class="mt-3 self-start" />}
      </li>
    ))}
  </ul>
</section>
