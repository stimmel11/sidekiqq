---
import { site } from '../lib/site';
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---
<footer class="mt-24 border-t border-line">
  <div class="wrap grid gap-8 py-12 md:grid-cols-[1fr_auto]">
    <div class="max-w-md">
      <Logo />
      <p class="mt-3 text-muted">{site.tagline}</p>
      <p class="mt-4 text-sm text-muted">{site.footer.note}</p>
    </div>
    <nav aria-label="Footer">
      <ul class="flex flex-wrap gap-x-6 gap-y-2 md:flex-col md:items-end">
        {site.footer.links.map((l) => <li><a href={l.href} class="text-muted hover:text-fg">{l.label}</a></li>)}
        {site.social.map((l) => <li><a href={l.href} rel="me noopener" class="text-muted hover:text-fg">{l.label}</a></li>)}
      </ul>
    </nav>
  </div>
  <div class="wrap pb-10 text-sm text-muted">&copy; {year} {site.name}</div>
</footer>
